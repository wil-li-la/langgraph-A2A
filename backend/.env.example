# =====================================================================
# LLM Provider (opt-in). Default `none` keeps the scripted workflow
# behavior identical to the no-LLM baseline. Set this to enable the
# agentic features (NLU upgrade, /api/agent ReAct agent).
# =====================================================================
# none | ollama | openai | google | anthropic
LLM_PROVIDER=none
LLM_TIMEOUT_SECONDS=30

# Ollama (local, no API key)
# Install: https://ollama.com  +  `ollama pull qwen3:4b`
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:4b

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.5-flash

# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# =====================================================================
# VLM detector (open-vocab object detection + JSON scene memory).
# Configured independently from the agent's chat LLM because qwen3:4b
# is text-only. Default targets a local Ollama running qwen2.5vl:7b
# (`ollama pull qwen2.5vl:7b`). Set DETECT_PROVIDER=none to disable.
# =====================================================================
DETECT_PROVIDER=ollama
DETECT_MODEL=qwen2.5vl:7b
DETECT_HOST=http://localhost:11434
DETECT_TIMEOUT=60
SCENE_MEMORY_FILE=
SCENE_MEMORY_MAX_SCENES=200
SCENE_MEMORY_MAX_PER_OBJECT=20
SCENE_MEMORY_RECALL_LIMIT=5

# =====================================================================
# Legacy vars (kept for back-compat with current scripts; not required)
# =====================================================================
model_source=google

# Robot / deployment
ROBOT_IP=
PUBLIC_URL=

# =====================================================================
# On-robot FUNMAP nav stack (post-2026-05-25 migration).
# Backend forwards /api/nav/goto to robot goto:5557 (msgpack REQ/REP)
# and subscribes to map_pub:5562 + amcl_pose:5563. See
# docs/steretch3_protocol/protocols.md for wire shape.
# Pre-FUNMAP NVBLOX_NAV_* vars are gone — the lab nav_service no
# longer exists.
# =====================================================================
STRETCH_ROBOT_HOST=192.168.1.38
STRETCH_GOTO_PORT=5557
STRETCH_SCAN_PORT=5561
STRETCH_MAP_PORT=5562
STRETCH_AMCL_POSE_PORT=5563
STRETCH_AMCL_SEED_PORT=5564
STRETCH_GOTO_TIMEOUT_S=60
STRETCH_AMCL_SEED_TIMEOUT_S=2.0
STRETCH_AMCL_STALE_S=2.0