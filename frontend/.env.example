# Backend base URL. Defaults to http://localhost:9999 when unset.
# Examples:
#   http://localhost:9999                — local dev on same machine
#   http://192.168.1.100:9999            — LAN IP (no HTTPS; mic APIs disabled on other devices)
#   https://stretch-api.your-domain.com  — Cloudflare-tunneled; mic + getUserMedia work on iPad/phone
NEXT_PUBLIC_API_URL=

# Optional: overrides the pre-filled value of the "Robot IP" input on
# the dashboard. Defaults to 192.168.1.38 (the lab robot's LAN IP) in
# the code if unset. Robot connection is an optional add-on — the user
# still has to click Connect.
NEXT_PUBLIC_ROBOT_HOST=

# Room cameras (16 fixed Basler ceiling cams in ED305) are served EXCLUSIVELY by
# MediaMTX as of 2026-06-01 — the cam_bridge (NVENC), room_cameras (:9997 MJPEG),
# and direct-MJPEG fallbacks were removed (see ADR-0001). Configure MediaMTX below.

# MediaMTX endpoints (see backend/mediamtx/). Pick HLS or WebRTC based on
# how the dashboard is reached:
#
#   NEXT_PUBLIC_MEDIAMTX_HLS_URL    — pure HTTP, traverses Cloudflare
#     Tunnel cleanly. ~200-400 ms latency with HLS-LL. Use this in
#     production behind a tunnel.
#     Examples:
#       https://localhost:8888                    — local dev
#       https://stretch-cams.your-domain.com     — Cloudflare-tunneled
#
#   NEXT_PUBLIC_MEDIAMTX_WEBRTC_URL — sub-100 ms latency over LAN. Needs
#     UDP (port :8189), which doesn't pass through Cloudflare Tunnel
#     without a TURN server. Use only when the browser and MediaMTX are
#     on the same network.
#     Examples:
#       https://localhost:8889                    — local dev
#
# Precedence in the component: HLS > WebRTC. Set whichever fits your
# deployment; leave the other empty.
NEXT_PUBLIC_MEDIAMTX_HLS_URL=
NEXT_PUBLIC_MEDIAMTX_WEBRTC_URL=

# Optional: WebSocket URL of the rosbridge_websocket launched by
# backend/nav_bridge/launch/nav.launch.py (default port 9090). Both
# the /nav page (2D OccupancyGrid + Path overlays) and the /recon
# page (live 3D nvblox mesh, native Three.js) subscribe via this WS.
# When unset, both pages show a "configure" banner.
# Examples:
#   ws://localhost:9090                — same machine
#   ws://192.168.1.100:9090            — LAN only (no SSL)
#   wss://stretch-fg.your-domain.com   — Cloudflare-tunneled (preferred)
NEXT_PUBLIC_ROSBRIDGE_WS_URL=
