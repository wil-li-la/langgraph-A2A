# Backend base URL. Defaults to http://localhost:9999 when unset.
# Examples:
#   http://localhost:9999                — local dev on same machine
#   http://192.168.1.100:9999            — LAN IP (no HTTPS; mic APIs disabled on other devices)
#   https://stretch-api.your-domain.com  — Cloudflare-tunneled; mic + getUserMedia work on iPad/phone
NEXT_PUBLIC_API_URL=

# Optional: overrides the pre-filled value of the "Robot IP" input on
# the dashboard. Defaults to 192.168.1.38 (the lab robot's LAN IP) in
# the code if unset. Robot connection is an optional add-on — the user
# still has to click Connect.
NEXT_PUBLIC_ROBOT_HOST=

# Optional: base URL of the ROS2 → MJPEG room-camera bridge running
# alongside the backend (see backend/room_cameras/). When unset, the
# /cameras page shows a "bridge URL not configured" banner and the rest
# of the dashboard is unaffected.
# Examples:
#   http://localhost:9997                — same machine
#   http://192.168.1.50:9997             — LAN host
#   https://stretch-cams.your-domain.com — Cloudflare-tunneled
NEXT_PUBLIC_ROOM_CAMERAS_URL=

# Optional: base URL(s) of the pylon-cameras servers
# (see https://github.com/wil-li-la/ED305_pylon_ros). One per ED305 side;
# set whichever side(s) are online. /cameras renders long-lived MJPEG
# streams (one persistent connection per tile).
#
# Prefer the Caddy HTTP/2 endpoint (https://<host>:8443) over the raw
# web_video_server (http://<host>:8080). HTTP/2 multiplexes all streams
# over a single TCP connection — removes the browser's 6-per-origin
# HTTP/1.1 cap, and avoids the /snapshot wedge bug in web_video_server
# (see issue #1 on the camera-host repo).
#
# Self-signed cert note: the Caddy proxy uses `tls internal` (local CA),
# so on first visit the browser will prompt to trust the cert. To
# suppress on a viewer machine, install caddy on it and run
# `sudo caddy trust`, or trust the root cert at
# /var/lib/caddy/.local/share/caddy/pki/authorities/local/root.crt.
#
# Examples:
#   https://192.168.1.13:8443            — LAN Caddy HTTP/2 (preferred)
#   http://192.168.1.13:8080             — raw web_video_server (HTTP/1.1, capped)
#   https://cams-right.your-domain.com   — Cloudflare-tunneled (HTTP/2)
NEXT_PUBLIC_PYLON_CAMS_RIGHT_URL=
NEXT_PUBLIC_PYLON_CAMS_LEFT_URL=

# Optional: URL of the cam_bridge service (see backend/cam_bridge/).
# When set, /cameras renders <video> H.264 streams from the bridge instead
# of <img> MJPEG directly from the camera hosts. The bridge:
#   - holds ONE long-lived MJPEG connection per camera to upstream
#     (avoids web_video_server's per-request wedge bug entirely)
#   - serves HTTP/2 over TLS — all N streams multiplex over one TCP
#     connection, no browser per-origin cap
#   - shares ONE ffmpeg + NVENC session per camera across all viewers
# Must be https:// (browsers require TLS for HTTP/2). The bridge generates
# a self-signed cert on first run — trust it into Chrome's NSS db once
# (see backend/cam_bridge/README.md).
# Examples:
#   https://localhost:9998               — bridge on same machine
#   https://stretch-cams.your-domain.com — Cloudflare-tunneled bridge
NEXT_PUBLIC_CAM_BRIDGE_URL=

# MediaMTX endpoints (see backend/mediamtx/). Pick HLS or WebRTC based on
# how the dashboard is reached:
#
#   NEXT_PUBLIC_MEDIAMTX_HLS_URL    — pure HTTP, traverses Cloudflare
#     Tunnel cleanly. ~200-400 ms latency with HLS-LL. Use this in
#     production behind a tunnel.
#     Examples:
#       https://localhost:8888                    — local dev
#       https://stretch-cams.your-domain.com     — Cloudflare-tunneled
#
#   NEXT_PUBLIC_MEDIAMTX_WEBRTC_URL — sub-100 ms latency over LAN. Needs
#     UDP (port :8189), which doesn't pass through Cloudflare Tunnel
#     without a TURN server. Use only when the browser and MediaMTX are
#     on the same network.
#     Examples:
#       https://localhost:8889                    — local dev
#
# Precedence in the component: HLS > WebRTC > cam_bridge h264 > direct MJPEG.
# Set whichever fits your deployment; leave the others empty.
NEXT_PUBLIC_MEDIAMTX_HLS_URL=
NEXT_PUBLIC_MEDIAMTX_WEBRTC_URL=

# Optional: WebSocket URL of the rosbridge_websocket launched by
# backend/nav_bridge/launch/nav.launch.py (default port 9090). Both
# the /nav page (2D OccupancyGrid + Path overlays) and the /recon
# page (live 3D nvblox mesh, native Three.js) subscribe via this WS.
# When unset, both pages show a "configure" banner.
# Examples:
#   ws://localhost:9090                — same machine
#   ws://192.168.1.100:9090            — LAN only (no SSL)
#   wss://stretch-fg.your-domain.com   — Cloudflare-tunneled (preferred)
NEXT_PUBLIC_ROSBRIDGE_WS_URL=
