# Backend base URL. Defaults to http://localhost:9999 when unset.
# Examples:
#   http://localhost:9999                — local dev on same machine
#   http://192.168.1.100:9999            — LAN IP (no HTTPS; mic APIs disabled on other devices)
#   https://stretch-api.your-domain.com  — Cloudflare-tunneled; mic + getUserMedia work on iPad/phone
NEXT_PUBLIC_API_URL=

# Optional: overrides the pre-filled value of the "Robot IP" input on
# the dashboard. Defaults to 192.168.1.38 (the lab robot's LAN IP) in
# the code if unset. Robot connection is an optional add-on — the user
# still has to click Connect.
NEXT_PUBLIC_ROBOT_HOST=

# Optional: base URL of the ROS2 → MJPEG room-camera bridge running
# alongside the backend (see backend/room_cameras/). When unset, the
# /cameras page shows a "bridge URL not configured" banner and the rest
# of the dashboard is unaffected.
# Examples:
#   http://localhost:9997                — same machine
#   http://192.168.1.50:9997             — LAN host
#   https://stretch-cams.your-domain.com — Cloudflare-tunneled
NEXT_PUBLIC_ROOM_CAMERAS_URL=

# Optional: WebSocket URL of the foxglove_bridge launched by
# backend/nav_bridge/launch/nav.launch.py (default port 8766). The /viz
# page embeds Foxglove Studio (app.foxglove.dev) and points it at this
# WS to render nvblox mesh, ESDF, costmaps, /tf, etc. When unset, /viz
# shows a "configure" banner.
# Examples:
#   ws://localhost:8766                — same machine
#   ws://192.168.1.100:8766            — LAN only (no SSL — Foxglove cloud
#                                        will reject; self-host instead)
#   wss://stretch-fg.your-domain.com   — Cloudflare-tunneled (preferred)
NEXT_PUBLIC_FOXGLOVE_WS_URL=

# Optional: URL of a self-hosted Foxglove Studio. Only needed if
# app.foxglove.dev refuses iframe embedding (X-Frame-Options) or you
# don't want the dashboard to depend on Foxglove's cloud. Run e.g.:
#   docker run -d -p 8000:8080 ghcr.io/foxglove/studio:latest
# then set NEXT_PUBLIC_FOXGLOVE_STUDIO_URL=http://lab-host:8000
NEXT_PUBLIC_FOXGLOVE_STUDIO_URL=
