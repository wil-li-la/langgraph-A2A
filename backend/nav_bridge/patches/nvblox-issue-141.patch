+      // PATCH (issue #141): the default Subscriber ctor leaves
+      // compatible_data_format = "" → MessageType::GetDefaultCompatibleFormat()
+      // returns "nitros_image_rgb8" for images, so the depth subscriber
+      // negotiates as rgb8, fails, and the depth callback is never invoked
+      // for 16UC1 / mono16 / 32FC1 publishers. We default-construct, then
+      // call subscribe() with the explicit format. nitros_image_mono16 covers
+      // 16UC1 depth (which is what sensors_bridge publishes for RealSense).
+      {
+        auto depth_sub =
+          std::make_shared<nvidia::isaac_ros::nitros::message_filters::Subscriber<NitrosView>>();
+        depth_sub->subscribe(this, base_name_depth + "/image", input_qos_profile,
+                             rclcpp::SubscriptionOptions(), "nitros_image_mono16");
+        depth_image_subs_.emplace_back(depth_sub);
